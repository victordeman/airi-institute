# NAIRA Environment Variables Template

# --- Database ---
# URL for the Turso/libSQL database
TURSO_DATABASE_URL=your-turso-url-here
# Auth token for the Turso database
TURSO_AUTH_TOKEN=your-turso-token-here

# --- AI APIs ---
# Google AI Studio key (Required for Gemini & RAG embeddings)
GOOGLE_API_KEY=your-google-key-here
# Hugging Face Access Token (Optional for Llama/Mistral models)
HF_TOKEN=your-hf-token-here
# Hugging Face API token
# Used for: Stable Fast 3D (primary) + TRELLIS Spaces (fallback)
# Get from: https://huggingface.co/settings/tokens
# Scope: Read
HF_API_TOKEN=hf_your-token-here

# --- Authentication ---
# Secret key for JWT token signing
SECRET_KEY=your-secret-key-here

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# --- Security ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
