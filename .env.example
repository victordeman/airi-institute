# AIRI Institute Environment Variables Template

# --- Database ---
# URL for the Turso/libSQL database
TURSO_DATABASE_URL=your-turso-url-here
# Auth token for the Turso database
TURSO_AUTH_TOKEN=your-turso-token-here

# --- AI APIs ---
# Stability AI API — used for Stable Fast 3D
# Get from: https://platform.stability.ai
STABILITY_API_KEY=sk-your-key-here

# Hugging Face token — used for TRELLIS.2, Hunyuan3D, Hi3DGen, TripoSR (HF Spaces)
# Get from: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your-token-here

# Google Gemini API key for RAG
GOOGLE_API_KEY=your-key-here

# Hugging Face Access Token (Optional for Llama/Mistral models)
HF_TOKEN=your-hf-token-here

# --- Authentication ---
# Secret key for JWT token signing
SECRET_KEY=your-secret-key-here

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# --- Security ---
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
